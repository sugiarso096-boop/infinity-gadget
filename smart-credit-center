
<script>
  // Ganti dengan URL Web App Apps Script Anda yang baru
  const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycby17Q2eA07dbWtZGg59LgqH27mRnRASGVHojnMLkUjR_Dxg5pn-LHjePzf3CE3oxFFbwA/exec';

  // Fungsi mengubah angka menjadi format Rupiah
  function formatRupiah(angka) {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0
    }).format(angka);
  }

  // Mengambil data dari Google Sheets
  async function loadDashboardData() {
    try {
      const response = await fetch(SCRIPT_URL);
      const data = await response.json();
      
      // Memasukkan data ke dalam HTML
      document.getElementById('total-sisa').innerText = formatRupiah(data.totalSisaKredit);
      document.getElementById('count-aktif').innerText = data.pelangganAktif;
      document.getElementById('count-terlambat').innerText = data.terlambat;
      document.getElementById('count-lunas').innerText = data.lunas;
    } catch (error) {
      console.error('Error saat mengambil data:', error);
      document.getElementById('total-sisa').innerText = "Gagal memuat";
    }
  }

  // Jalankan fungsi saat halaman web pertama kali dibuka
  window.onload = loadDashboardData;
</script>
